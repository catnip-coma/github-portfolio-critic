# ==============================================================================
# GitGauge Environment Configuration
# ==============================================================================

# GitHub Personal Access Token (Optional, but recommended)
# Unauthenticated requests are limited to 60 requests/hour by GitHub.
# Supplying a token increases the limit to 5,000 requests/hour.
# Generate at: https://github.com/settings/tokens (no special scopes needed for public data)
GITHUB_TOKEN=

# Google Gemini API Key (Required for AI recruiter critique)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Application Settings
PORT=8000
HOST=127.0.0.1
DEBUG=True
CACHE_TTL_SECONDS=600
